-- ระบบการทำงานภายในเมนู (Logic & Functionalities)
local speedToggled = false
speedBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        speedToggled = not speedToggled
        if speedToggled then
            hum.WalkSpeed = 32
            speedBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
            speedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            hum.WalkSpeed = 16
            speedBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            speedBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        end
    end
end)

local jumpToggled = false
jumpBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        jumpToggled = not jumpToggled
        if jumpToggled then
            hum.JumpPower = 100
            jumpBtn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
            jumpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            hum.JumpPower = 50
            jumpBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            jumpBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        end
    end
end)

resetBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        speedToggled = false
        jumpToggled = false
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        speedBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        speedBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        jumpBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        jumpBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    end
end)

